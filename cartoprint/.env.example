# Terralis Environment Variables
# Copy this file to .env.local and fill in values

# --- Map (no keys needed for free services) ---
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Vector tile style. Override to self-host tiles.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Payment is only enabled when every commerce dependency below is configured.
COMMERCE_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Prodigi (Print Fulfillment) ---
# Sign up at https://dashboard.prodigi.com/
PRODIGI_API_KEY=
PRODIGI_ENV=sandbox
PRODIGI_WEBHOOK_TOKEN=

# --- Supabase (Database) ---
# Create project at https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (if using NextAuth) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Export / Storage ---
EXPORT_STORAGE_URL=
# HTTPS worker that accepts a versioned PrintScene and returns a public,
# 300-DPI artworkUrl for fulfillment. Keep COMMERCE_MODE=demo without it.
PRINT_RENDER_SERVICE_URL=
PRINT_RENDER_SERVICE_TOKEN=
